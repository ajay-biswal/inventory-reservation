generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  generatedFileExtension = "ts"
   importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

enum CheckoutStatus {
  RESERVED
  SUCCESSFUL
  FAILED
  ABANDONED
  EXPIRED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum PaymentStatus {
  PENDING
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

model Product {
  id        String   @id @default(uuid())
  name      String
  pricePaise Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]
  checkouts Checkout[]

  @@index([name])
}

model Location {
  id        String   @id @default(uuid())
  name      String
  city      String
  state     String
  priority  Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory    Inventory[]
  serviceZones ServiceZone[]
  checkouts    Checkout[]

  @@index([city])
  @@index([state])
  @@index([active])
}

model ServiceZone {
  id         String @id @default(uuid())
  locationId String
  pincode    String

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, pincode])
  @@index([pincode])
}

model Inventory {
  id         String   @id @default(uuid())
  productId  String
  locationId String
  stock      Int      @default(0)
  reserved   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model Checkout {
  id              String         @id @default(uuid())
  productId       String
  quantity        Int
  unitPricePaise  Int
  locationId      String
  idempotencyKey  String         @unique
  payloadHash     String
  deliveryPincode String
  deliveryCity    String
  deliveryState   String
  status          CheckoutStatus
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  product     Product      @relation(fields: [productId], references: [id])
  location    Location     @relation(fields: [locationId], references: [id])
  reservation Reservation?
  payment     Payment?

  @@index([productId])
  @@index([locationId])
  @@index([status])
  @@index([expiresAt])
}

model Reservation {
  id         String            @id @default(uuid())
  checkoutId String            @unique
  quantity   Int
  status     ReservationStatus
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
}


model Payment {
  id                String        @id @default(uuid())
  checkoutId        String        @unique
  provider          String        @default("RAZORPAY")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amountPaise       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)

  @@index([status])
}